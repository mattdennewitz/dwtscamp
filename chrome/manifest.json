{
  "manifest_version": 3,
  "name": "Bandcamp Disturbed Intro",
  "version": "1.0.0",
  "description": "Plays Disturbed's iconic ooo-ah-ah-ah before any Bandcamp track plays.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bandcamp.com/*",
        "*://bandcamp.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "disturbed-ooo-ah-ah-ah.mp3",
        "content.js"
      ],
      "matches": [
        "*://*.bandcamp.com/*",
        "*://bandcamp.com/*"
      ]
    }
  ]
}
